# ContractIQ — environment variables
# Copy this file to .env.local (Next.js) and fill in real values.
# Source: docs/engineering/engineering-doc.md

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=              # Supabase project URL — Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon/public key — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY — Project Settings > API. Used for signed URLs + Storage ops. Never expose to the client or commit a real value.

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=                        # SERVER ONLY — platform.openai.com/api-keys. Never expose to the client. Called exclusively from Next.js Route Handlers.
OPENAI_MODEL=gpt-4o                    # Model id used for extraction and chat (engineering-doc §8)
OPENAI_ORG_ID=                         # Optional — platform.openai.com/settings/organization, only if using an org-scoped key

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
CRON_SECRET=                           # SERVER ONLY — random string. Vercel Cron sends this automatically as a Bearer token when set; protects /api/cron/retention-cleanup from public access.

# ---------------------------------------------------------------------------
# Security (docs/security/security-plan.md)
# ---------------------------------------------------------------------------
# Rate limiting is DB-backed (lib/security/rateLimiter.ts, the
# rate_limit_events table in supabase/rls-policies.sql) — correct across
# multiple serverless instances, unlike an in-memory counter. No additional
# env vars needed for it.
MAX_CHAT_HISTORY=200                   # Max prior chat_messages rows loaded as conversation context per turn (lib/security/tokenLimiter.ts)

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Base URL used for redirects (e.g. auth email confirmation links)
NODE_ENV=development                        # development | production | test
